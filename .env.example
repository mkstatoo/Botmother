# ───────── ربات مادر ─────────
# توکن ربات مادر (از @BotFather). همین ربات است که سازندگان با آن ربات می‌سازند.
BOT_TOKEN=
# آیدی عددی ادمین‌های پلتفرم، با کاما جدا شوند (دسترسی به /admin در ربات مادر)
ADMIN_IDS=

# ───────── اجرا ─────────
# polling: ساده، نیازی به دامنه ندارد (پیش‌فرض)
# webhook: سریع‌تر؛ نیاز به BASE_URL با https دارد
MODE=polling
# آدرس عمومی سرور (مثلاً https://bots.example.com). برای درگاه‌های پرداخت آنلاین و حالت webhook لازم است.
BASE_URL=
WEB_HOST=0.0.0.0
WEB_PORT=8080
# اگر سرور به تلگرام دسترسی مستقیم ندارد: socks5://127.0.0.1:1080 یا http://host:port
PROXY_URL=
LOG_LEVEL=INFO

# ───────── داده‌ها ─────────
# SQLite (پیش‌فرض) یا PostgreSQL: postgresql+asyncpg://user:pass@host/dbname
DATABASE_URL=sqlite+aiosqlite:///data/botfactory.db
DATA_DIR=data
# کلید رمزنگاری توکن‌ها و کلیدهای درگاه‌ها. اگر خالی بماند، یک‌بار در data/fernet.key ساخته می‌شود.
# ⚠️ از این کلید حتماً نسخه‌ی پشتیبان بگیرید؛ بدون آن اطلاعات رمزنگاری‌شده قابل بازیابی نیست.
# ساخت کلید:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
# اختیاری: ذخیره‌ی مراحل گفتگو روی Redis تا با ری‌استارت پاک نشود  (redis://localhost:6379/0)
REDIS_URL=

# ───────── محدودیت‌ها ─────────
MAX_BOTS_PER_USER=3
# سرعت ارسال همگانی (پیام در ثانیه). سقف تلگرام حدود ۳۰ است.
BROADCAST_RATE=20

# ───────── درگاه‌ها (معمولاً نیازی به تغییر نیست) ─────────
# اگر سرورتان خارج از ایران است و زرین‌پال IP خارجی را نمی‌پذیرد، آدرس یک رله/پروکسی داخل ایران را اینجا بگذارید.
ZARINPAL_BASE=https://payment.zarinpal.com
NOWPAYMENTS_BASE=https://api.nowpayments.io/v1
